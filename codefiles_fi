def compute_stock_info(med: Dict[str, Any]) -> Dict[str, Any]:
    qty = med.get(\"quantity\", 0) or 0
    daily = med.get(\"daily_dose\", 1) or 1
    # Sum of consumed logs (taken only)
    # For MVP treat quantity as current remaining after user updates.
    consumed = med.get(\"consumed\", 0) or 0
    remaining = max(qty - consumed, 0)
    days_left = int(remaining // daily) if daily > 0 else 0
    runout_date = None
    if daily > 0 and remaining > 0:
        runout_date = (datetime.now(timezone.utc).date() + timedelta(days=days_left)).isoformat()
    return {\"remaining\": remaining, \"days_left\": days_left, \"runout_date\": runout_date, \"low_stock\": days_left <= 7}


