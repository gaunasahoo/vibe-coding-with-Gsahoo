@api_router.post(\"/med-logs\")
async def log_medicine(payload: MedLogIn, user=Depends(get_current_user)):
    # Check existing
    existing = await db.med_logs.find_one({
        \"medicine_id\": payload.medicine_id,
        \"scheduled_slot\": payload.scheduled_slot,
        \"scheduled_date\": payload.scheduled_date,
        \"user_id\": user[\"id\"],
    })
    if existing:
        # Update status
        await db.med_logs.update_one({\"id\": existing[\"id\"]}, {\"$set\": {\"status\": payload.status, \"updated_at\": now_iso()}})
        # Adjust consumed if changed to taken
        med = await db.medicines.find_one({\"id\": payload.medicine_id})
        if med and existing.get(\"status\") != \"taken\" and payload.status == \"taken\":
            await db.medicines.update_one({\"id\": payload.medicine_id}, {\"$inc\": {\"consumed\": 1}})
        elif med and existing.get(\"status\") == \"taken\" and payload.status != \"taken\":
            await db.medicines.update_one({\"id\": payload.medicine_id}, {\"$inc\": {\"consumed\": -1}})
        log = await db.med_logs.find_one({\"id\": existing[\"id\"]}, {\"_id\": 0})
        return log
    doc = payload.dict()
    doc[\"id\"] = str(uuid.uuid4())
    doc[\"user_id\"] = user[\"id\"]
    doc[\"created_at\"] = now_iso()
    await db.med_logs.insert_one(doc.copy())
    if payload.status == \"taken\":
        await db.medicines.update_one({\"id\": payload.medicine_id}, {\"$inc\": {\"consumed\": 1}})
    doc.pop(\"_id\", None)
    return doc


