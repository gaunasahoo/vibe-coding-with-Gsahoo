@api_router.get(\"/dashboard\")
async def dashboard(parent_id: Optional[str] = None, user=Depends(get_current_user)):
    q = {\"user_id\": user[\"id\"]}
    if parent_id:
        q[\"parent_id\"] = parent_id
    meds = await db.medicines.find(q, {\"_id\": 0}).to_list(500)
    for m in meds:
        m.update(compute_stock_info(m))
    low = [m for m in meds if m.get(\"active\") and m.get(\"low_stock\")]
    today = datetime.now(timezone.utc).date().isoformat()
    logs_today = await db.med_logs.find({**q, \"scheduled_date\": today}, {\"_id\": 0}).to_list(500)
    taken = len([l for l in logs_today if l[\"status\"] == \"taken\"])
    skipped = len([l for l in logs_today if l[\"status\"] == \"skipped\"])
    missed = len([l for l in logs_today if l[\"status\"] == \"missed\"])
    upcoming = await db.appointments.find({**q, \"appointment_date\": {\"$gte\": today}}, {\"_id\": 0}).sort(\"appointment_date\", 1).limit(5).to_list(5)
    monthly_expense = sum([m.get(\"price\") or 0 for m in meds if m.get(\"active\")])
    return {
        \"active_medicines\": len([m for m in meds if m.get(\"active\")]),
        \"low_stock_meds\": low,
        \"adherence_today\": {\"taken\": taken, \"skipped\": skipped, \"missed\": missed},
        \"upcoming_appointments\": upcoming,
        \"monthly_expense\": monthly_expense,
    }


