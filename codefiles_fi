def _extract_json(text: str) -> Dict[str, Any]:
    # find first {...}
    m = re.search(r\"\{[\s\S]*\}\", text)
    if m:
        try:
            return json.loads(m.group(0))
        except Exception:
            pass
    return {}


@api_router.post(\"/ai/ocr-prescription\")
async def ai_ocr_prescription(payload: OCRIn, user=Depends(get_current_user)):
    if not EMERGENT_LLM_KEY:
        raise HTTPException(500, \"AI key not configured\")
    try:
        chat = LlmChat(
            api_key=EMERGENT_LLM_KEY,
            session_id=f\"ocr-{uuid.uuid4()}\",
            system_message=(
                \"You are a medical prescription OCR assistant. Extract medicines from a prescription image. \"
                \"Return ONLY strict JSON with this shape: \"
                '{\"doctor_name\": string|null, \"hospital\": string|null, \"date\": string|null, '
                '\"medicines\": [{\"name\": string, \"dosage\": string|null, \"frequency\": string|null, '
                '\"duration\": string|null, \"before_food\": \"before\"|\"after\"|null, \"notes\": string|null}]}'
                \" Do not include any prose.\"
            ),
        ).with_model(\"gemini\", \"gemini-3-flash-preview\")
        image = ImageContent(image_base64=payload.image_base64)
        msg = UserMessage(text=\"Extract prescription details. Return JSON only.\", file_contents=[image])
        # Use non-stream send
        resp = await chat.send_message(msg)
        data = _extract_json(resp if isinstance(resp, str) else str(resp))
        return {\"raw\": resp if isinstance(resp, str) else str(resp), \"parsed\": data}
    except Exception as e:
        logging.exception(\"OCR failed\")
        raise HTTPException(500, f\"OCR failed: {str(e)}\")


