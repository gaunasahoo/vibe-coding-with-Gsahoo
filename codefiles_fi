    meds = await db.medicines.find({\"user_id\": user[\"id\"], \"$or\": [{\"name\": regex}, {\"generic_name\": regex}, {\"category\": regex}]}, {\"_id\": 0}).to_list(100)
    visits = await db.visits.find({\"user_id\": user[\"id\"], \"$or\": [{\"doctor_name\": regex}, {\"hospital\": regex}, {\"diagnosis\": regex}]}, {\"_id\": 0}).to_list(100)
    appts = await db.appointments.find({\"user_id\": user[\"id\"], \"$or\": [{\"doctor_name\": regex}, {\"hospital\": regex}]}, {\"_id\": 0}).to_list(100)
    return {\"medicines\": meds, \"visits\": visits, \"appointments\": appts}


